NODE_ENV=development
LOG_LEVEL=log

API_GATEWAY_PORT=3000
IDENTITY_SERVICE_PORT=3001
LEARNING_SERVICE_PORT=3002
SUBMISSION_SERVICE_PORT=3003
JUDGE_SERVICE_PORT=3004
COMMUNITY_SERVICE_PORT=3005
CORS_ORIGINS=http://localhost:3006,http://localhost:3001

IDENTITY_SERVICE_URL=http://localhost:3001
LEARNING_SERVICE_URL=http://localhost:3002
SUBMISSION_SERVICE_URL=http://localhost:3003
COMMUNITY_SERVICE_URL=http://localhost:3005
LEARNING_INTERNAL_URL=http://localhost:3002

POSTGRES_USER=bkpractice
POSTGRES_PASSWORD=change-this-local-postgres-password
POSTGRES_PORT=5432
IDENTITY_DATABASE_URL=postgresql://bkpractice:change-this-local-postgres-password@localhost:5432/bkpractice_identity
# Used only by the intentional RBAC seed command; do not commit real credentials.
SEED_ADMIN_LOGIN_ID=replace-with-admin-login-code
SEED_ADMIN_EMAIL=replace-with-admin-email@example.invalid
SEED_ADMIN_PASSWORD=replace-with-a-private-admin-password
LEARNING_DATABASE_URL=postgresql://bkpractice:change-this-local-postgres-password@localhost:5432/bkpractice_learning
SUBMISSION_DATABASE_URL=postgresql://bkpractice:change-this-local-postgres-password@localhost:5432/bkpractice_submission
COMMUNITY_DATABASE_URL=postgresql://bkpractice:change-this-local-postgres-password@localhost:5432/bkpractice_community

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
AUTH_FLOW_STORE=redis

RABBITMQ_USER=bkpractice
RABBITMQ_PASSWORD=change-this-local-rabbitmq-password
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://bkpractice:change-this-local-rabbitmq-password@localhost:5672

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters-access
JWT_REFRESH_SECRET=replace-with-at-least-32-random-characters-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_SECRET=replace-with-staging-application-secret
MICROSOFT_REDIRECT_URI=http://localhost:3000/api/auth/microsoft/callback
AUTH_WEB_LOGIN_REDIRECT_URL=http://localhost:3006/auth/callback

R2_ACCOUNT_ID=00000000000000000000000000000000
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_REFERENCE_SIGNING_KEY=replace-with-at-least-32-random-characters
R2_BUCKET=bkpractice
R2_SIGNED_URL_TTL_SECONDS=300
R2_MAX_UPLOAD_BYTES=5242880
R2_ALLOWED_CONTENT_TYPES=image/png,image/jpeg,image/webp
R2_CLEANUP_GRACE_SECONDS=3600

AUTH_RATE_LIMIT_TTL_MS=60000
AUTH_PASSWORD_LOGIN_RATE_LIMIT=5
AUTH_OAUTH_RATE_LIMIT=30
INTERNAL_SERVICE_SECRET=replace-with-at-least-32-random-internal-secret

JUDGE_WORKSPACE_ROOT=/tmp/bkpractice-judge
JUDGE_MAX_OUTPUT_BYTES=1048576
JUDGE_DOCKER_BINARY=docker


SEED_ADMIN_LOGIN_ID=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

ACCOUNT_IMPORT_PASSWORD=

BREVO_API_KEY=replace-with-brevo-api-key
BREVO_SENDER_EMAIL=verified-sender@example.com
BREVO_SENDER_NAME=BKPractice