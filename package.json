{
  "name": "bkpractice-backend",
  "version": "0.1.0",
  "private": true,
  "description": "BKPractice backend microservices monorepo",
  "license": "UNLICENSED",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "env:setup": "node scripts/setup-env.mjs",
    "dev": "concurrently -n gateway,identity,learning,submission,judge,community -c blue,green,yellow,magenta,cyan,white \"pnpm dev:gateway\" \"pnpm dev:identity\" \"pnpm dev:learning\" \"pnpm dev:submission\" \"pnpm dev:judge\" \"pnpm dev:community\"",
    "dev:gateway": "nest start api-gateway --watch",
    "dev:identity": "nest start identity-service --watch",
    "dev:learning": "nest start learning-service --watch",
    "dev:submission": "nest start submission-service --watch",
    "dev:judge": "nest start judge-service --watch",
    "dev:community": "nest start community-service --watch",
    "start:gateway": "node dist/apps/api-gateway/main.js",
    "start:identity": "node dist/apps/identity-service/main.js",
    "start:learning": "node dist/apps/learning-service/main.js",
    "start:submission": "node dist/apps/submission-service/main.js",
    "start:judge": "node dist/apps/judge-service/main.js",
    "start:community": "node dist/apps/community-service/main.js",
    "build": "nest build api-gateway && nest build identity-service && nest build learning-service && nest build submission-service && nest build judge-service && nest build community-service",
    "build:gateway": "nest build api-gateway",
    "build:identity": "nest build identity-service",
    "build:learning": "nest build learning-service",
    "build:submission": "nest build submission-service",
    "build:judge": "nest build judge-service",
    "build:community": "nest build community-service",
    "lint": "eslint \"{apps,libs,test}/**/*.ts\"",
    "lint:fix": "pnpm lint --fix",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage --runInBand",
    "infra:up": "docker compose up -d postgres redis rabbitmq",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f postgres redis rabbitmq",
    "apps:up": "docker compose --profile apps up --build",
    "compose:config": "docker compose config",
    "judge:images:build": "docker build -t bkpractice-judge-c:latest docker/judge/c && docker build -t bkpractice-judge-cpp:latest docker/judge/cpp && docker build -t bkpractice-judge-java:latest docker/judge/java && docker build -t bkpractice-judge-python:latest docker/judge/python",
    "migration:generate:identity": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/identity-service/src/database/data-source.ts migration:generate apps/identity-service/src/database/migrations/IdentitySchema",
    "migration:run:identity": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/identity-service/src/database/data-source.ts migration:run",
    "migration:revert:identity": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/identity-service/src/database/data-source.ts migration:revert",
    "migration:generate:learning": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/learning-service/src/database/data-source.ts migration:generate apps/learning-service/src/database/migrations/LearningSchema",
    "migration:run:learning": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/learning-service/src/database/data-source.ts migration:run",
    "migration:revert:learning": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/learning-service/src/database/data-source.ts migration:revert",
    "migration:generate:submission": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/submission-service/src/database/data-source.ts migration:generate apps/submission-service/src/database/migrations/SubmissionSchema",
    "migration:run:submission": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/submission-service/src/database/data-source.ts migration:run",
    "migration:revert:submission": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/submission-service/src/database/data-source.ts migration:revert",
    "migration:generate:community": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/community-service/src/database/data-source.ts migration:generate apps/community-service/src/database/migrations/CommunitySchema",
    "migration:run:community": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/community-service/src/database/data-source.ts migration:run",
    "migration:revert:community": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/community-service/src/database/data-source.ts migration:revert",
    "commitlint": "commitlint --from HEAD~1 --to HEAD",
    "seed:identity:rbac": "node --env-file=.env -r ts-node/register -r tsconfig-paths/register apps/identity-service/src/database/seed-rbac.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@azure/msal-node": "^7.1.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/platform-socket.io": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "@nestjs/websockets": "^11.1.6",
    "amqplib": "^0.10.9",
    "argon2": "^0.44.0",
    "axios": "^1.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "exceljs": "^4.4.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.7.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "typeorm": "^0.3.27",
    "yauzl": "^3.4.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.7",
    "@nestjs/testing": "^11.1.6",
    "@types/amqplib": "^0.10.7",
    "@types/express": "^5.0.3",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.18.0",
    "@types/yauzl": "^3.4.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.16.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^16.1.6",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "argon2"
    ]
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  }
}
